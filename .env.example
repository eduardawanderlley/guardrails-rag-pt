# Provedor de LLM: extractive (offline, padrão) | simulated (linha de base) | anthropic
GR_LLM_PROVIDER=extractive

# Modelo usado quando GR_LLM_PROVIDER=anthropic
GR_ANTHROPIC_MODEL=claude-haiku-5-5

# Chave da API. Nunca commite o valor real.
ANTHROPIC_API_KEY=

# Quantos documentos recuperar por pergunta
GR_TOP_K=3

# Confiança mínima para responder. Abaixo disso, a pergunta é escalonada.
GR_MIN_CONFIDENCE=0.6
